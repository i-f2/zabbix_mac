# =============================================================================
# Zabbix Monitor as Code (MaC) - 环境变量模板
# =============================================================================
# 复制为 .env 并填入实际值，用于 Docker 运行时注入敏感配置。
# 用法: docker run --env-file .env ... zabbix-mac:latest
# 注意: .env 文件已在 .gitignore 中，不会被提交。
# =============================================================================

# --- 数据库 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ops
DB_USER=postgres
DB_PASSWORD=

# --- Flask ---
APP_SECRET_KEY=change-me-in-production
APP_PORT=5000

# --- Zabbix 环境凭据（可选，也可在 config.yaml 中配置）---
# ZABBIX_SZSE_ZW_URL=
# ZABBIX_SZSE_ZW_USER=
# ZABBIX_SZSE_ZW_PASS=
# ZABBIX_SZSE_HLW_URL=
# ZABBIX_SZSE_HLW_USER=
# ZABBIX_SZSE_HLW_PASS=
# ZABBIX_SSE_ZW_URL=
# ZABBIX_SSE_ZW_USER=
# ZABBIX_SSE_ZW_PASS=
# ZABBIX_SSE_HLW_URL=
# ZABBIX_SSE_HLW_USER=
# ZABBIX_SSE_HLW_PASS=

# --- 环境切换 ---
# local = 本地 Docker Zabbix 5.0 沙箱 (http://localhost:8080)
# test  = 测试环境
# 留空  = 使用 config.yaml 默认值
ENV=local

# =============================================================================
# 本地开发容器配置 — ENV=local 时自动加载，覆盖 config.yaml 中的 Zabbix 环境
# =============================================================================
# 用法:
#   cp config_local.yaml.example config_local.yaml
#   ENV=local python3 app.py
#
# config_loader.py 会在 load_config() 末尾检测 ENV 环境变量，
# 如果存在则加载 config_{ENV}.yaml 并将内容深度合并到主配置中。
# =============================================================================

zabbix_environments:
  - key: local
    name: "本地Docker沙箱"
    url: "http://localhost:8080/api_jsonrpc.php"
    username: "Admin"
    password: "zabbix"
